{
  "extends": [
    "config:best-practices"
  ],
  "addLabels": ["dependencies"],
  "ignorePaths": [
    "apache/**",
    "awscli/**",
    "backup/**",
    "deluge/**",
    "fpm/**",
    "gpg**/**",
    "puppet**/**",
    "r10k/**",
    "s3sync**/**",
    "webhook/**"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "platformAutomerge": true
}
